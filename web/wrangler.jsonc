{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kinic-memory-dashboard",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    // SPA: unknown paths fall back to index.html; /api/* always reaches the Worker.
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "routes": [{ "pattern": "memory-dashboard.kinic.xyz", "custom_domain": true }],
  "workers_dev": false,
  "observability": { "enabled": true },
  "vars": {
    "GEMINI_MODEL": "gemini-3-flash-preview"
  },
  // Per-IP limit for /api/chat. Set GEMINI_API_KEY with `wrangler secret put GEMINI_API_KEY`.
  "ratelimits": [
    {
      "name": "CHAT_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 20, "period": 60 }
    }
  ]
}
